NEXT_PUBLIC_CONTENTFUL_SPACE_ID=your_contentful_space_id_here
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=your_contentful_access_token_here

# Blog Worker (workers/comments): comments + notification emails — see README
COMMENTS_API_URL=https://ngoc-blog-comments.<your-subdomain>.workers.dev
COMMENTS_API_SECRET=same_value_as_worker_API_SECRET
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Contentful webhook -> /api/revalidate (header x-revalidate-secret)
REVALIDATE_SECRET=random_string
